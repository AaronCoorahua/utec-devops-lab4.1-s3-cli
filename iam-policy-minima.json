{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdministrarBucketsDelLab",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketWebsite"
      ],
      "Resource": "arn:aws:s3:::utec-s3-lab-*"
    },
    {
      "Sid": "ObjetosDentroDeEsosBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::utec-s3-lab-*/*"
    }
  ]
}
